generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChatChannel {
  whatsapp
  instagram
  messenger
  x
  telegram
  website
}

enum WebhookDirection {
  inbound
  outbound
}

enum QualificationStatus {
  new
  qualified
  unqualified
  needs_review
}

enum CrmStatus {
  pending
  synced
  failed
}

enum ResponseStyle {
  casual
  professional
  warm
  concierge
}

enum MessageDirection {
  inbound
  outbound
}

/// One row per real human. Identifying fields (phone, email) are kept
/// here so the same person on multiple channels collapses to one record.
model Customer {
  id                  String              @id
  leadName            String?
  email               String?
  phone               String?
  location            String?
  preferredService    String?
  responseStyle       ResponseStyle?
  qualificationStatus QualificationStatus
  crmStatus           CrmStatus
  crmRecordId         String?
  lastIntent          String?
  lastMessageAt       DateTime
  firstSeenAt         DateTime
  updatedAt           DateTime

  identities    ChannelIdentity[]
  interests     Interest[]
  conversations Conversation[]
  webhookEvents WebhookEvent[]

  @@index([phone])
  @@index([email])
  @@index([updatedAt])
}

/// One row per (channel, sourceId). A customer owns N of these so we
/// can recognise them across WhatsApp, Telegram, Instagram, etc.
model ChannelIdentity {
  id             String      @id
  customerId     String
  channel        ChatChannel
  sourceId       String
  senderName     String?
  username       String?
  conversationId String
  firstSeenAt    DateTime
  lastSeenAt     DateTime

  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([channel, sourceId])
  @@index([customerId])
  @@index([username])
}

/// Append-only log of every distinct interest the bot picks up.
/// Lets us answer "what was customer X interested in last month".
model Interest {
  id         String   @id @default(cuid())
  customerId String
  kind       String
  value      String
  capturedAt DateTime

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, kind, value])
  @@index([customerId, capturedAt])
}

model Conversation {
  id                String      @id
  customerId        String
  channelIdentityId String
  channel           ChatChannel
  sourceId          String
  createdAt         DateTime
  updatedAt         DateTime

  customer        Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channelIdentity ChannelIdentity       @relation(fields: [channelIdentityId], references: [id], onDelete: Cascade)
  messages        ConversationMessage[]

  @@index([customerId])
  @@index([channelIdentityId])
}

model ConversationMessage {
  id             String           @id @default(cuid())
  conversationId String
  direction      MessageDirection
  messageId      String
  text           String?
  messageType    String
  timestamp      DateTime
  metadata       Json

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, timestamp])
}

model WebhookEvent {
  id             String           @id
  channel        ChatChannel
  direction      WebhookDirection
  path           String
  sourceId       String
  conversationId String
  customerId     String?
  receivedAt     DateTime
  payload        Json

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([receivedAt])
  @@index([customerId])
}

model DedupeKey {
  key    String   @id
  seenAt DateTime

  @@index([seenAt])
}

/// Editable product catalogue. Seeded once from the CSV and managed
/// through the admin UI thereafter. Rasa reads via POST /products/search.
model Product {
  productId      String   @id
  productName    String
  category       String
  productType    String
  brand          String
  priceMyr       Float
  description    String?
  frameMaterial  String?
  frameShape     String?
  frameColor     String?
  gender         String?
  uvProtection   String?
  polarized      String?
  lensColor      String?
  frameStyle     String?
  lensType       String?
  lensFeature    String?
  lensDuration   String?
  multifocal     String?
  storeLocation  String?
  city           String?
  stockStatus    String   @default("in_stock")
  rating         Float?
  bestseller     Boolean  @default(false)
  newArrival     Boolean  @default(false)
  imageUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([productType])
  @@index([brand])
  @@index([priceMyr])
}
