# Environment Variables for Chatbot Integrations

# ─── Server ───────────────────────────────────────────
PORT=3000
WEBHOOK_BASE_URL=https://your-domain.com/webhook

# ─── WhatsApp (Meta Cloud API) ────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=your_verify_token_here
WHATSAPP_CLIENT_SECRET=
WHATSAPP_API_VERSION=v22.0

# ─── Instagram (Meta Graph API) ──────────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_VERIFY_TOKEN=your_verify_token_here
INSTAGRAM_API_VERSION=v21.0

# ─── NLP (Rasa) ──────────────────────────────────────
RASA_URL=http://localhost:5005

# ─── Facebook Messenger (Meta Graph API) ─────────────
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_PAGE_ID=
MESSENGER_VERIFY_TOKEN=your_verify_token_here
MESSENGER_CLIENT_ID=
MESSENGER_CLIENT_SECRET=
MESSENGER_APP_TOKEN=
MESSENGER_API_VERSION=v21.0

# ─── HubSpot CRM ─────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CLIENT_SECRET=

# ─── Google Sheets ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
GSHEETS_SPREADSHEET_ID=

# ─── Gmail ────────────────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/auth/gmail/callback
GMAIL_PUBSUB_TOPIC=