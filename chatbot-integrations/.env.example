# Server
PORT=3000
RASA_URL=http://localhost:5005
DATA_DIR=data/runtime
DEDUP_TTL_MS=300000
RESPONSE_STYLE=casual

# LLM fallback layer (Llama 3 via Ollama)
# Rasa NLU is the primary classifier. The LLM is only consulted when
# /model/parse on Rasa returns intent `nlu_fallback` (or confidence below
# RASA_NLU_CONFIDENCE_FLOOR). If the LLM is also unsure
# (confidence < LLM_CONFIDENCE_FLOOR), the raw user text is forwarded to Rasa
# so its built-in `action_default_fallback` produces the user-facing fallback.
LLM_LAYER_ENABLED=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_MS=8000
OLLAMA_TEMPERATURE=0.1
# Should match (or sit just above) the FallbackClassifier `threshold` in
# calisto_nlp_export/config.yml.
RASA_NLU_CONFIDENCE_FLOOR=0.4
LLM_CONFIDENCE_FLOOR=0.35

# Storage: postgres (default) or file (JSON fallback / dev without DB)
# If postgres is selected but DATABASE_URL is empty, the app falls back to file storage.
STORAGE_BACKEND=postgres

# Local PostgreSQL only. Prisma (@prisma/client) is the ORM — not a cloud database.
# Quick start: docker compose -f docker-compose.postgres.yml up -d
# Then: npm run db:migrate:dev && npm run db:studio
DATABASE_URL=postgresql://calisto:calisto@localhost:5432/calisto_chatbot

# Public base URL used to absolutise product image URLs sent to channels
# (Telegram/WhatsApp/Messenger fetch images from the public internet, so a
# bare /static/products/... path will not work). In dev, set this to your
# Cloudflare tunnel URL (e.g. https://xxx.trycloudflare.com).
PUBLIC_BASE_URL=http://localhost:3000

# Optional: external paths for one-off DB seed scripts (not used at runtime)
# KB_CATALOGUE_PATH=/path/to/products.csv
# KB_INDEX_META_PATH=/path/to/calisto_meta.json

# Website Chat
# Optional bearer token required for POST /webchat/message
WEBSITE_AUTH_TOKEN=
# Optional comma-separated allowlist, for example https://www.calisto.my,https://staging.calisto.my
WEBSITE_ALLOWED_ORIGINS=
WEBSITE_RATE_LIMIT_MAX=30
WEBSITE_RATE_LIMIT_WINDOW_MS=60000

# WhatsApp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_CLIENT_SECRET=
WHATSAPP_API_VERSION=v22.0

# Instagram
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ID=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_API_VERSION=v21.0

# Messenger
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_PAGE_ID=
MESSENGER_VERIFY_TOKEN=
MESSENGER_CLIENT_ID=
MESSENGER_CLIENT_SECRET=
MESSENGER_APP_TOKEN=
MESSENGER_API_VERSION=v23.0

# X
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Optional override. Defaults to https://api.x.com/1.1
# X_API_BASE_URL=

# Telegram
TELEGRAM_BOT_TOKEN=
# Optional extra webhook verification. Must match the secret_token passed to setWebhook.
# TELEGRAM_SECRET_TOKEN=
# Optional override. Defaults to https://api.telegram.org
# TELEGRAM_API_BASE_URL=

# HubSpot
HUBSPOT_ACCESS_TOKEN=
