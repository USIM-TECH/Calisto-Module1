# Calisto chatbot-integrations — copy to .env and fill in secrets.
#   cp .env.example .env
#
# Docker compose (which file to use):
#   Local dev (npm run dev):  chatbot-integrations/docker-compose.mysql.yml  → MySQL + Redis only
#   Full stack in Docker:     repo-root/docker-compose.yml                   → MySQL, Redis, integration API, Rasa, action server (+ optional Ollama, reasoning server)
#   Rasa only:                calisto_nlp_export/docker-compose.yml
#
# This file is the single source of truth for integration config. The repo-root
# docker-compose.yml reads the same variable names from a .env in the repo root
# when you run `docker compose up` there (copy or symlink if needed).

# Runtime
PORT=3000
RASA_URL=http://localhost:5005
DATA_DIR=data/runtime
DEDUP_TTL_MS=300000
RESPONSE_STYLE=casual

# LLM fallback layer (Llama 3 via Ollama)
# Only invoked when Rasa NLU returns `nlu_fallback` or confidence below
# RASA_NLU_CONFIDENCE_FLOOR. If the LLM is also unsure, Rasa's own
# action_default_fallback fires.
LLM_LAYER_ENABLED=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_MS=8000
OLLAMA_TEMPERATURE=0.1
RASA_NLU_CONFIDENCE_FLOOR=0.4
LLM_CONFIDENCE_FLOOR=0.35

# Storage — local MySQL (Prisma ORM; not a hosted DB)
# Start DB: docker compose -f docker-compose.mysql.yml up -d
# Then: ./scripts/setup-database.sh   (or npm run db:setup)
STORAGE_BACKEND=mysql
DATABASE_URL=mysql://calisto:calisto@localhost:3306/calisto_chatbot
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=calisto
CACHE_PRODUCT_CATALOGUE_TTL_SEC=300
CACHE_KNOWLEDGE_CHUNKS_TTL_SEC=600
CACHE_KNOWLEDGE_SUMMARY_TTL_SEC=300
CACHE_LEADS_LIST_TTL_SEC=60
CACHE_TELEGRAM_ALIAS_TTL_SEC=86400

# Public HTTPS URL for channel webhooks and product-card images (use your Cloudflare tunnel in dev)
PUBLIC_BASE_URL=http://localhost:3000

# Admin dashboard auth — required for /admin/* and /reports/*
# Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=

# Encrypts channel account credentials at rest in MySQL (32 bytes as 64 hex chars)
# Generate with: openssl rand -hex 32
CHANNEL_CREDENTIALS_ENCRYPTION_KEY=

# Rasa action server → integration API (set in calisto_nlp_export/docker-compose when needed)
BACKEND_API_BASE_URL=http://localhost:3000

# Website chat
WEBSITE_AUTH_TOKEN=
WEBSITE_ALLOWED_ORIGINS=
WEBSITE_RATE_LIMIT_MAX=30
WEBSITE_RATE_LIMIT_WINDOW_MS=60000

# Legacy channel credentials — auto-imported into MySQL on first startup when the
# ChannelAccount table is empty. After that, manage accounts in the admin dashboard.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v25.0
# WHATSAPP_CLIENT_SECRET=

INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ID=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_API_VERSION=v25.0
# INSTAGRAM_CLIENT_SECRET=

MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_PAGE_ID=
MESSENGER_VERIFY_TOKEN=
MESSENGER_CLIENT_ID=
MESSENGER_CLIENT_SECRET=
MESSENGER_API_VERSION=v25.0

X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# X_API_BASE_URL=

TELEGRAM_BOT_TOKEN=
# TELEGRAM_SECRET_TOKEN=
# TELEGRAM_API_BASE_URL=

# HUBSPOT_ACCESS_TOKEN=

# Optional: paths for one-off DB seed scripts (not used at runtime)
# KB_CATALOGUE_PATH=/path/to/products.csv
# KB_INDEX_META_PATH=/path/to/calisto_meta.json
