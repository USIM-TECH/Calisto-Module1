{
  "name": "chatbot-integrations",
  "version": "1.0.0",
  "description": "Standalone chatbot integration layer for WhatsApp, Instagram, Messenger, and HubSpot",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "dev": "tsx watch src/app/server.ts",
    "start": "node dist/app/server.js",
    "check:type": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:setup": "bash scripts/setup-database.sh",
    "db:reset:dev": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:seed:products": "tsx src/products/service/seed-from-csv.ts",
    "db:seed:stores": "tsx src/products/service/seed-stores-from-csv.ts",
    "db:seed:knowledge": "tsx src/knowledge/service/seed-from-meta-json.ts",
    "db:seed:presets": "tsx src/products/service/seed-presets.ts",
    "db:seed:channel-accounts": "tsx src/channel-accounts/seed-from-env.ts",
    "telegram:webhook": "tsx scripts/register-telegram-webhook.ts"
  },
  "dependencies": {
    "@hubspot/api-client": "^13.1.0",
    "@prisma/client": "6.18.0",
    "awesome-phonenumber": "^7.5.0",
    "axios": "^1.6.2",
    "dotenv": "^16.4.4",
    "express": "^4.18.2",
    "ioredis": "^5.11.1",
    "mammoth": "^1.9.0",
    "marked": "^15.0.1",
    "multer": "^2.1.1",
    "node-html-parser": "^6.0.0",
    "pdf-parse": "^1.1.1",
    "whatsapp-api-js": "^5.3.0",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.16.4",
    "@types/pg": "^8.20.0",
    "pg": "^8.22.0",
    "prisma": "6.18.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0"
  }
}
