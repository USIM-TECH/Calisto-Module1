{
  "name": "chatbot-integrations",
  "version": "1.0.0",
  "description": "Standalone chatbot integration layer for WhatsApp, Instagram, Messenger, and HubSpot",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "dev": "tsx watch src/app/server.ts",
    "start": "node dist/app/server.js",
    "check:type": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:import-json": "tsx scripts/import-runtime-store-json.ts"
  },
  "dependencies": {
    "@hubspot/api-client": "^13.1.0",
    "@prisma/client": "6.18.0",
    "awesome-phonenumber": "^7.5.0",
    "axios": "^1.6.2",
    "dotenv": "^16.4.4",
    "express": "^4.18.2",
    "marked": "^15.0.1",
    "node-html-parser": "^6.0.0",
    "whatsapp-api-js": "^5.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.16.4",
    "prisma": "6.18.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0"
  }
}
