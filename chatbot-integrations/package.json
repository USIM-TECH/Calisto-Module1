{
  "name": "chatbot-integrations",
  "version": "1.0.0",
  "description": "Standalone chatbot integration layer - supports WhatsApp, Instagram, Messenger, HubSpot, Google Sheets, and Gmail",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "check:type": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "express": "^4.18.2",
    "googleapis": "^144.0.0",
    "@hubspot/api-client": "^13.1.0",
    "whatsapp-api-js": "^5.3.0",
    "marked": "^15.0.1",
    "awesome-phonenumber": "^7.5.0",
    "zod": "^3.22.4",
    "dotenv": "^16.4.4",
    "nodemailer": "^6.7.2",
    "node-html-parser": "^6.0.0",
    "gmail-api-parse-message": "^2.1.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.16.4",
    "@types/nodemailer": "^6.4.4",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0"
  }
}
