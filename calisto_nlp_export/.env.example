# URL of the chatbot-integrations backend API
BACKEND_API_BASE_URL=http://localhost:3000

# Must match ADMIN_API_TOKEN in chatbot-integrations/.env
BACKEND_API_KEY=

# Set automatically by start-all.sh / set-meta-webhooks.sh
PUBLIC_BASE_URL=

# Set to true to enable Llama 3 LLM fallback via Ollama
LLM_LAYER_ENABLED=false

DEFAULT_STORE_HOURS="10:00 AM to 10:00 PM daily"
CONVERSATION_GUARD_WINDOW_SECONDS=4
PLACEHOLDER_IMAGE_BASE_URL=https://dummyimage.com

# Redis URL for Rasa tracker store and lock store
# For local development (bare metal): redis://localhost:6379/1
# For Docker: redis://redis:6379/1 (configured in endpoints.docker.yml)
REDIS_URL=redis://localhost:6379/1
