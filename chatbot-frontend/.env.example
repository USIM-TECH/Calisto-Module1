# Leave empty: the dashboard must be served from the same origin as the API so the
# admin session cookie works. In dev, Vite proxies /auth, /admin, /reports, ...
# to VITE_DEV_BACKEND_URL. Setting this to another origin (e.g. http://localhost:3000)
# makes requests cross-origin and login fails with a CORS error.
VITE_API_BASE_URL=
# Optional: only if chatbot-integrations/.env sets WEBSITE_AUTH_TOKEN
# VITE_WEBSITE_AUTH_TOKEN=
# Optional: override Vite dev proxy target (defaults to http://localhost:3000)
# VITE_DEV_BACKEND_URL=http://localhost:3000
